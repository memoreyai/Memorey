# Copy to .env.local and fill in values. Never commit .env.local.
#
# -----------------------------------------------------------------------------
# REQUIRED — Supabase (database, auth, storage)
# Get Project URL, anon key, and service_role from:
#   Supabase Dashboard → your project → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# REQUIRED — AI providers (search embeddings, assistants, ingest, exports, etc.)
# Anthropic: https://console.anthropic.com/ → API keys
# OpenAI: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — App URLs & metadata
# -----------------------------------------------------------------------------
# Public site URL (used for links, OG, billing redirects). Defaults shown in code if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical site URL for metadata (optional; falls back to VERCEL_URL / localhost)
NEXT_PUBLIC_SITE_URL=
# Public base URL of the Memorey MCP server (e.g. Railway) — shown in Settings
NEXT_PUBLIC_MCP_SERVER_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — Dodo Payments (billing features disabled without these)
# Get keys from Dodo Payments Dashboard → Developer → API keys
# Webhook secret: Dashboard → Developer → Webhooks → your endpoint → Secret Key
# Product IDs: Dashboard → Products → view product details
# Pro Monthly: $8 USD / ₹699 INR   |   Pro Yearly: $79 USD / ₹6,999 INR
# -----------------------------------------------------------------------------
DODO_SECRET_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRO_MONTHLY_PRICE_ID=
DODO_PRO_YEARLY_PRICE_ID=

# -----------------------------------------------------------------------------
# OPTIONAL — Supabase Storage bucket name for temporary export share links (service role uploads)
# -----------------------------------------------------------------------------
SUPABASE_EXPORT_BUCKET=memorey-exports
