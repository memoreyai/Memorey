{
  "manifest_version": 3,
  "name": "Memorey",
  "version": "0.1.0",
  "description": "Your personal AI memory — platform-agnostic, user-owned.",
  "permissions": ["sidePanel", "storage", "activeTab"],
  "side_panel": {
    "default_path": "sidebar/index.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Open Memorey"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
